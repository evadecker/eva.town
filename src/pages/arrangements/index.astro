---
import { getCollection } from "astro:content";
import { renderAll } from "astro-lilypond";
import ProseLayout from "../../layouts/ProseLayout.astro";

const title = "Arrangements";
const description = "Play these notes at a piano to make okay sounds.";

const scores = await getCollection("scores");
const rendered = await renderAll(
  scores.map((score) => score.data),
  { pdf: true },
);
const entries = scores.map((score, i) => ({ score, ...rendered[i] }));
---

<ProseLayout title={title} description={description}>
  <p>
    Below are some piano arrangements I've written. All music was typeset using <a
      href="https://lilypond.org">LilyPond</a
    >, a text-based music engraving language. Scores are displayed here using <a
      href="https://lilypond.ky.fyi">astro-lilypond</a
    >, an open source Astro integration I built.
  </p>
  {
    entries.map(({ score, Score, pdf }) => (
      <>
        <h2>
          <a href={`/arrangements/${score.id}`}>
            {score.data.meta.title}
            {score.data.meta.subtitle && ` (${score.data.meta.subtitle})`}
          </a>
        </h2>
        {score.data.meta.composer && (
          <span class="composer">By {score.data.meta.composer}</span>
        )}
        <div class="score">
          <Score />
        </div>
        {pdf && (
          <a href={pdf.src} download>
            Download PDF
          </a>
        )}
      </>
    ))
  }
</ProseLayout>

<style>
  .composer {
    display: block;
    margin-block-start: var(--space-2xs);
  }

  .score {
    ol[data-lilypond-group] {
      padding: var(--space-l) 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-s);
      list-style-type: none;

      @media (width > 600px) {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
