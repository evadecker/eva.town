---
import { getCollection } from "astro:content";
import { renderAll } from "astro-lilypond";
import ProseLayout from "../../layouts/ProseLayout.astro";

const title = "Arrangements";
const description = "Play these notes at a piano to make okay sounds.";

const scores = await getCollection("scores");
const rendered = await renderAll(
  scores.map((score) => score.data),
  { pdf: true },
);
const entries = scores.map((score, i) => ({ score, ...rendered[i] }));
---

<ProseLayout title={title} description={description}>
  <p>
    Below are some piano arrangements I've written. All music was typeset using <a
      href="https://lilypond.org">LilyPond</a
    >, a text-based music engraving language. Scores are displayed here using <a
      href="https://lilypond.ky.fyi">astro-lilypond</a
    >, an open source Astro integration I built.
  </p>
  <section class="arrangements-grid">
    {
      entries.map(({ meta, score, Score }) => (
        <a href={`/arrangements/${score.id}`} class="arrangement">
          <h2>
            {meta.title}
            {meta.subtitle && ` (${meta.subtitle})`}
          </h2>
          <Score pageLimit={1} />
        </a>
      ))
    }
  </section>
</ProseLayout>

<style>
  .arrangements-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .arrangement {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    text-decoration: none;

    h2 {
      font-size: var(--step-0);
      margin-block: 0 !important;
    }

    &:focus-visible {
      outline: none;

      img {
        outline: var(--gray-12) solid 2px;
        outline-offset: 4px;
      }
    }

    @media (hover: hover) {
      img {
        transition: transform 0.15s ease;
      }

      &:hover {
        img {
          transform: translateY(-5px);
        }
      }
    }
  }

  :global(ol[data-lilypond-group]) {
    padding: var(--space-l) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    list-style-type: none;

    @media (width > 600px) {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
