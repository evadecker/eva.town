---
import * as Plot from "@observablehq/plot";
import { parseHTML } from "linkedom";
import { type ScorecardCategory, surveys } from "./survey-data";

const { document: plotDocument } = parseHTML(
  "<html><head></head><body></body></html>",
);

type Raw = { date: Date; rating: number };

interface Props {
  category: ScorecardCategory;
  min?: number;
  width?: number;
  height?: number;
}

const {
  category,
  min = 1,
  width: WIDTH = 420,
  height: HEIGHT = 300,
} = Astro.props;

const { statement: title, ratings, counts, scale: max } = category;

const raw: Raw[] = [];
for (const survey of surveys) {
  const values = counts[survey.id];
  const date = new Date(survey.date);
  ratings.forEach((rating, i) => {
    for (let k = 0; k < values[i]; k++)
      raw.push({ date, rating: Number(rating) });
  });
}

const averageRatingOn = (date: Date) => {
  const points = raw.filter((point) => point.date.getTime() === date.getTime());
  return points.reduce((sum, point) => sum + point.rating, 0) / points.length;
};

const surveyDates: Date[] = surveys.map((survey) => new Date(survey.date));
const firstDate = surveyDates[0];
const lastDate = surveyDates[surveyDates.length - 1];

const startAvg = averageRatingOn(firstDate);
const endAvg = averageRatingOn(lastDate);
const percentChange = ((endAvg - startAvg) / startAvg) * 100;
const nearestPercent = Math.abs(Math.round(percentChange));

// Nudge a trailing 9 up (e.g. 39% -> 40%).
const roundedPercent =
  nearestPercent % 10 === 9 ? nearestPercent + 1 : nearestPercent;

const monthsSpan =
  (lastDate.getFullYear() - firstDate.getFullYear()) * 12 +
  (lastDate.getMonth() - firstDate.getMonth());

const STEADY_THRESHOLD = 1;
const direction =
  percentChange > 0 && roundedPercent >= 1
    ? "Up"
    : percentChange < 0 && roundedPercent > STEADY_THRESHOLD
      ? "Down"
      : "Steady";
const changePrefix =
  direction === "Steady" ? "Steady" : `${direction} ${roundedPercent}%`;

const meanLabel = (values: number[]) =>
  (values.reduce((a, b) => a + b, 0) / values.length).toFixed(2);

const ratingRows = Array.from({ length: max - min + 1 }, (_, i) => i + min);
const gridPoints = surveyDates.flatMap((date) =>
  ratingRows.map((rating) => ({ date, rating })),
);

const plot = Plot.plot({
  document: plotDocument,
  width: WIDTH,
  height: HEIGHT,
  marginTop: 0,
  marginLeft: 0,
  marginRight: 0,
  r: { range: [2, 20] },
  x: {
    type: "utc",
    domain: [firstDate, lastDate],
    insetLeft: 54,
    insetRight: 54,
  },
  y: {
    domain: [min, max],
    axis: null,
    insetTop: 48,
    insetBottom: 48,
  },
  marks: [
    Plot.axisX({
      ticks: surveyDates,
      fontSize: 14,
      stroke: "var(--gray-7)",
      fill: "var(--gray-11)",
    }),
    Plot.axisY({
      ticks: ratingRows,
      tickFormat: "d",
      anchor: "left",
      label: null,
      fontSize: 14,
      stroke: "var(--gray-7)",
      fill: "var(--gray-11)",
    }),
    Plot.frame({ stroke: "var(--gray-6)" }),

    // Dot grid at every possible (date, rating) position.
    Plot.dot(gridPoints, {
      x: "date",
      y: "rating",
      r: 1.5,
      fill: "var(--gray-6)",
    }),

    // Respondent counts per date/rating, sized by count.
    Plot.dot(
      raw,
      Plot.group(
        { r: "count" },
        { x: "date", y: "rating", fill: "var(--gray-5)" },
      ),
    ),

    // Mean rating per date: trend line, point, and value label.
    Plot.lineY(
      raw,
      Plot.groupX(
        { y: "mean" },
        { x: "date", y: "rating", curve: "catmull-rom" },
      ),
    ),
    Plot.dot(
      raw,
      Plot.groupX(
        { y: "mean" },
        { x: "date", y: "rating", r: 3, fill: "currentColor" },
      ),
    ),
    Plot.text(
      raw,
      Plot.groupX(
        { y: "mean", text: meanLabel },
        {
          x: "date",
          y: "rating",
          text: "rating",
          dy: -14,
          fontSize: "16",
          fontWeight: "bold",
          fill: "var(--gray-12)",
        },
      ),
    ),
  ],
});

plot.setAttributeNS(
  "http://www.w3.org/2000/xmlns/",
  "xmlns",
  "http://www.w3.org/2000/svg",
);
plot.setAttributeNS(
  "http://www.w3.org/2000/xmlns/",
  "xmlns:xlink",
  "http://www.w3.org/1999/xlink",
);

const chartMarkup = plot.outerHTML;
---

<div class="rating-chart">
  <h3 class="title">{title}</h3>
  <p class="change">
    <span
      class:list={[
        "change-value",
        {
          positive: direction === "Up",
          negative: direction === "Down",
          steady: direction === "Steady",
        },
      ]}
    >
      {changePrefix}
    </span>
    {` over ${monthsSpan} months`}
  </p>
  <div class="plot" set:html={chartMarkup} />
</div>

<style>
  .rating-chart {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;

    .title {
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      margin: 0;
    }

    .change {
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--gray-11);
      margin: var(--space-2xs) 0 var(--space-m);
    }

    .change-value {
      font-weight: var(--font-weight-medium);
      color: var(--gray-12);

      &.positive {
        color: var(--green-11);
      }

      &.negative {
        color: var(--red-11);
      }

      &.steady {
        color: var(--gray-11);
      }
    }

    .plot {
      min-height: 200px;

      :global(svg) {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
      }
    }
  }
</style>
