---
import RatingDistributionChart from "./RatingDistributionChart.astro";
import { scorecard } from "./survey-data";
---

<figure class="feature rating-distribution">
  <div class="grid">
    {
      scorecard.map((category) => (
        <RatingDistributionChart category={category} />
      ))
    }
  </div>
  <figcaption>
    <p>
      <strong>Survey trends.</strong> The design system survey asked each person to
      rate statements from 1 (strongly disagree) to 5 (strongly agree). Surveys were
      conducted every 6 months. Following improvements to the system, scores increased
      as time went on.
    </p>
  </figcaption>
</figure>

<style>
  .rating-distribution {
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
      padding-inline: var(--gutter);

      @media (900px <= width) {
        padding-block-end: var(--space-l);
        > :global(:not(:nth-child(3n + 1)) [aria-label^="y-axis tick"]) {
          display: none;
        }
      }

      @media (560px <= width < 900px) {
        grid-template-columns: repeat(2, 1fr);

        > :global(:not(:nth-child(2n + 1)) [aria-label^="y-axis tick"]) {
          display: none;
        }
      }

      @media (width < 560px) {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
